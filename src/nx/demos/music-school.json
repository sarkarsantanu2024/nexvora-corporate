    "exams": {
      "kicker": "Music board exams",
      "h2": "Year by year, from Prathama to Sangeet Visharad level.",
      "p": "Students who want a certificate sit for music board exams every year from the second year. We prepare them for the syllabus of the boards most Kolkata schools use. Here is what each stage looks like.",
      "photo": {
        "src": "/demo/music-school/images/tabla-player.jpg",
        "alt": "An elderly man in a white shirt playing tabla outdoors"
      },
      "h3": "How the exam season runs",
      "exam-list": {
        "items": [
          {
            "yr": "Yr 1",
            "h3": "No exam. Just learning.",
            "p": "Posture, breath, sargam or hand position. We do not put a six-year-old in front of an examiner."
          },
          {
            "yr": "Yr 2–3",
            "h3": "Junior years",
            "p": "Short theory paper and a practical of two or three pieces. Most children pass comfortably. Viva questions are practised in class from October."
          },
          {
            "yr": "Yr 4–5",
            "h3": "Middle years",
            "p": "Notation writing, raag identification, history of the form. Practical gets longer. Mock exams in January with teachers from other schools as examiners."
          },
          {
            "yr": "Yr 6+",
            "h3": "Senior and diploma level",
            "p": "Full performance plus a written paper. Students at this level usually teach the junior batches with us, which is the best preparation there is."
          }
        ]
      },
