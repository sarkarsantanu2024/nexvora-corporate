            "span": "idols made since 1952"
          }
        ]
      }
    },
    "idols": {
      "kicker": "What we make",
      "h2": "Idols for the home, the club and the pandal",
      "lede": "Prices below are for standard clay idols with basic sholar saaj (pith decoration). Daker saaj, zari work and custom themes are quoted separately. Half the amount is paid at booking, the rest on delivery.",
      "idols": {
        "items": [
