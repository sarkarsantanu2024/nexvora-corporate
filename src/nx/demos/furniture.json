    "custom": {
      "tag": "Custom orders",
      "h2": "Draw it on paper. We will make it in wood.",
      "p": "About half our work is made to order: a bed that fits an odd corner, an almirah that goes up to the ceiling, a dining table for a family of ten. This is how it goes, start to finish.",
      "proc": {
        "items": [
          {
            "when": "Day 1",
            "h3": "Measure",
            "p": "We come to your home with a tape and a notebook, or you send measurements and photos on WhatsApp."
          },
          {
            "when": "Day 2 to 3",
            "h3": "Drawing and quote",
            "p": "A sketch with sizes, the wood, the polish shade and a fixed price. Nothing changes after you say yes."
          },
          {
            "when": "Day 4",
            "h3": "Pick the wood",
            "p": "Come to the workshop and choose the planks yourself if you like. 50% advance to begin."
          },
          {
            "when": "Week 1 to 4",
            "h3": "Making",
            "p": "Cut, joined and assembled by hand. We send photos every week so you see it take shape."
          },
          {
            "when": "Week 5",
            "h3": "Polish",
            "p": "Three coats of melamine or PU, sanded between each. You approve the shade on a sample first."
          },
          {
            "when": "Week 6",
            "h3": "Delivery and fitting",
            "p": "Our own men deliver, assemble and fit in your room. Balance paid when you are happy."
          }
        ]
      }
    },
    "workshop": {
      "tag": "The workshop",
      "h2": "Behind the showroom, eleven carpenters and a wood yard.",
      "p": "Nirmal Bosu started with two carpenters in a tin shed in 1979. The shed is now a 4,000 sq ft workshop, but the way of working has not changed. Wood is bought in planks, stacked and air-dried in our own yard for at least eight months before anyone cuts it. That is why our doors do not warp in the monsoon.",
      "p2": "Joints are mortise and tenon, glued and pegged. No nails in the frame, no particle board hidden behind a veneer. Open any drawer and you will see wood all the way through.",
