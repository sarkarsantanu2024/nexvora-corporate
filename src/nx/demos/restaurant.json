    "story": {
      "kicker": "About us",
      "h2": "A family kitchen that grew into a restaurant.",
      "p": "Kutum Bari means the house of relatives. Shibani Chakraborty started cooking lunch for twelve office workers from her Gariahat flat in 1998. By 2004 it was forty tiffins a day and the ground floor became a six-table eatery.",
      "p2": "Her son Arnab runs it now with the same two cooks who came in 2004. The mutton is still cooked in the morning, the fish is still bought from Gariahat market by 7, and the mishti doi still comes from the shop next door.",
      "p3": "We are not a fancy place. We are the place you bring your parents to on a Sunday, and the place you order from on a weekday when nobody feels like cooking.",
      "photo": {
        "src": "/demo/restaurant/images/interior.jpg",
        "alt": "A wooden table for two under a Radha Krishna wall panel in the dining room"
      }
    },
