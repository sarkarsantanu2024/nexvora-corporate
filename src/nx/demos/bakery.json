    "order": {
      "kicker": "How to order",
      "h2": "Four messages and your cake is booked.",
      "steps": {
        "items": [
          {
            "h3": "Send the details",
            "p": "Flavour, weight, the name to write, and the date. A photo of a design you like if you have one. Eggless or not."
          },
          {
            "h3": "We confirm the price",
            "p": "You get the price, a sketch for theme cakes, and a pickup time. Pay ₹200 advance by UPI, or the full amount for cakes above 2 kg."
          },
          {
            "h3": "We bake it tomorrow",
            "p": "Cakes are baked in the morning and finished in the afternoon. We send you a photo before packing so you can ask for a change."
          },
          {
            "h3": "Pick up or delivery",
            "p": "Collect from the shop after 4 pm, or we deliver within 5 km for ₹60 (free above ₹1,500). Cakes travel in a cold box."
          }
        ]
      }
    },
    "faq": {
      "kicker": "Questions people ask",
      "h2": "Before you order.",
      "faq": {
        "items": [
          {
            "h3": "Can I get a cake today?",
            "p": "Only a plain half-kg chocolate or vanilla, if one is on the counter. Everything else needs an order by 6 pm the day before. For a theme or tier cake, three days."
          },
          {
            "h3": "Which areas do you deliver to?",
            "p": "Dum Dum, Nagerbazar, Lake Town, Baguiati, Belgharia, Sinthee and Dum Dum Cantonment. Roughly 5 km from the shop. Delivery is ₹60, free on orders above ₹1,500."
          },
          {
            "h3": "Are the eggless cakes really eggless?",
            "p": "Yes. They are baked in a separate oven with separate tins and bowls. If you need it on a day we do not bake eggless, tell us and we will arrange it."
          },
          {
            "h3": "Does the photo cake taste of paper?",
            "p": "No. The sheet is made of sugar and starch and melts into the cream within an hour. Faces print best on light coloured cream."
          },
          {
            "h3": "How long does a cake keep?",
            "p": "Fresh cream cakes should be eaten within 24 hours and kept in the fridge. Fondant cakes keep for two days. Take the cake out 30 minutes before cutting."
          },
          {
            "h3": "What if I need to cancel?",
            "p": "Cancel before we start baking (by 8 am on the day) and the advance comes back to you. After that the advance is kept because the cake is already made."
          }
        ]
      }
    },
