    "section-7": {
      "scribble": "How it works",
      "h2": "A term at Rong Tuli",
      "lede": "Three months, one theme, one wall show at the end. This is the same for a six-year-old and a sixty-year-old.",
      "steps": {
        "items": [
          {
            "h3": "Trial class",
            "p": "Come for one free class. We watch how you hold the pencil and suggest a batch. No admission fee for the trial."
          },
          {
            "h3": "Weeks 1 to 4",
            "p": "Basics for the term's theme: lines, shapes, tone. Everyone draws the same still life so progress is easy to see."
          },
          {
            "h3": "Weeks 5 to 10",
            "p": "Your own work. Teacher sits with each student for ten minutes every class. Corrections are drawn on tracing paper, never on your sheet."
          },
          {
            "h3": "Wall show",
            "p": "Last Sunday of the term. Work goes up on the studio wall, parents and friends come, tea is served. Then a new term begins."
          }
        ]
      }
    },
