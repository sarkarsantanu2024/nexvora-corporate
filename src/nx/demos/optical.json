    "faq": {
      "kicker": "Common questions",
      "h2": "Things people ask at the counter.",
      "faq": {
        "items": [
          {
            "h3": "Is the eye test really free?",
            "p": "Yes. There is no charge and no condition to buy. If you only want the prescription on paper, that is fine."
          },
          {
            "h3": "Can I bring my own frame and get new lenses?",
            "p": "Yes, if the frame is in good condition. Lens prices are the same as the table. We check the frame first and tell you if it is too weak to hold new lenses."
          },
          {
            "h3": "What if the new power does not feel right?",
            "p": "Come back within 30 days. We re-test for free and change the lenses at no cost if the power was wrong. For progressives we give a 30-day change guarantee."
          },
          {
            "h3": "Do you accept a prescription from an eye hospital?",
            "p": "Yes. Bring the paper. If it is more than six months old we will suggest a fresh free test, but it is your choice."
          },
          {
            "h3": "Do you repair glasses?",
            "p": "Nose pads, screws, and small adjustments are free, even for glasses not bought here. Temple replacement and soldering of metal frames cost ₹150 to ₹400."
          },
          {
            "h3": "Can I pay by UPI or card?",
            "p": "Yes. UPI, cards and cash. For orders above ₹5,000 we can split the payment over three months on most credit cards."
          }
        ]
      }
