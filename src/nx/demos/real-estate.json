      "fees-list": {
        "items": [
          {
            "h3": "Renting a flat: one month’s rent",
            "p": "Paid once, after you sign the agreement and get the keys. If the rent is ₹20,000, our fee is ₹20,000. The owner pays us the same from their side. Nothing is due before you move in."
          },
          {
            "h3": "Buying a flat: 1% of the sale price",
            "p": "Paid at registration, not before. On a ₹60 lakh flat that is ₹60,000. It covers every visit, the price talks with the owner, and sitting with you through the paperwork."
          },
          {
            "h3": "What is not ours",
            "p": "Stamp duty, registration fee, society transfer charge, lawyer’s fee and the police verification fee are paid directly by you to those offices. We tell you the amounts in writing before you decide."
          },
          {
            "h3": "No site visit charge, no listing charge",
            "p": "Seeing flats costs nothing. If you do not take a flat through us, you owe us nothing. We make our fee only when a deal closes."
          }
        ]
      }
