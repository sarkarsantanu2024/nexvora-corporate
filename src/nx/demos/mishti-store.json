    "story": {
      "photo": {
        "src": "/demo/mishti-store/images/story-900.webp",
        "alt": "Trays and boxes of sweets on the shop counter"
      },
      "kicker": "Our story",
      "h2": "Three generations at one stove",
      "p": "Haren Das opened a small sweet counter on Dum Dum Road in 1987 with one big karai and a recipe for rosogolla he learnt from his uncle. The karai is still in use, and so is the recipe.",
      "p2": "Today his son and granddaughter run the shop. Chhena is made in our kitchen every morning, nolen gur comes from the same family in Joynagar every winter, and nothing is kept for the next day. We started home delivery because our regulars moved to flats and asked us to.",
      "sign": "The Das family"
    },
    "faq": {
      "kicker": "Questions",
      "h2": "Before you order",
      "list": {
        "items": [
          {
            "h3": "Where do you deliver, and what does it cost?",
            "p": "Dum Dum, Nagerbazar, Lake Town, Baguiati, Kestopur, Ultadanga and Belgachia. Delivery is ₹30 to Dum Dum, Nagerbazar and Belgachia, and ₹50 to the others. It is free on orders above ₹499. The smallest order we deliver is ₹199."
          },
          {
            "h3": "How fresh are the sweets?",
            "p": "Everything is made the same morning. Chhena sweets are best within two days, so please keep them in the fridge. We never send yesterday’s sweets."
          },
          {
            "h3": "Can I pay cash on delivery?",
            "p": "Yes. Pay cash or scan our UPI QR when the sweets reach you. You can also pay by UPI while ordering."
          },
          {
            "h3": "Can I cancel or change my order?",
            "p": "Call or WhatsApp us before your order is packed and we will change or cancel it. Once it is out for delivery we cannot take it back, because sweets cannot be resold."
          },
          {
            "h3": "Do you take bulk orders for pujo and weddings?",
            "p": "Yes, from 200 pieces. Fill in the bulk order form above and we reply on WhatsApp within the hour with a price. Please give us two days for large orders."
          },
          {
            "h3": "Do you have sugar-free sweets?",
            "p": "Yes. Sugar-free sandesh and kaju barfi, made with a natural sweetener or dates. They still have milk and nuts, so please check with your doctor if you are diabetic."
          }
        ]
      }
    },
    "visit": {
      "kicker": "Visit us",
      "h2": "Come for a hot singara",
      "h3": "Address",
      "p": "42 Dum Dum Road, Kolkata 700030. Two minutes from Dum Dum metro, opposite the bus stand.",
      "button": "Open in Google Maps",
      "h32": "Hours",
      "p2": "Shop: every day, 7 am to 10 pm.<br>Home delivery: 10 am to 9 pm.<br>Jilipi from 4 pm.",
      "h33": "Call or WhatsApp"
    },
