# Neon Postgres connection string (use the POOLED one, host contains "-pooler").
# Leave empty on your own machine: the app then runs on an embedded Postgres
# (PGlite) stored in .data/, creates the tables and loads sample data by itself.
DATABASE_URL=

# Signs the login cookie. Any long random string; required in production.
SESSION_SECRET=

# Photo storage. Leave empty locally (files go to .data/uploads).
# On Vercel: create a Blob store and it sets this for you.
BLOB_READ_WRITE_TOKEN=

# Optional. Lets the voice assistant understand free-form sentences.
# Without it the built-in command grammar still works.
ANTHROPIC_API_KEY=

# Public address of the site, used in links, sitemap and WhatsApp messages.
NEXT_PUBLIC_SITE_URL=http://localhost:3400
