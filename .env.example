# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# The live property (G-06RYPVJNB3) is the default in src/app/layout.tsx, so
# this only needs setting to point a deployment at a DIFFERENT property —
# a staging site, say. Development builds never report either way.
NEXT_PUBLIC_GA_ID=

# Edit panel (src/nx). Leave all of these unset to run without a database:
# the panel then keeps edits in each visitor's browser only, which is what
# the public demo panel does. Set DATABASE_URL to a Neon Postgres connection
# string to store real client content; tables are created on first use.
DATABASE_URL=
# Signs the login cookie. Any long random string.
NX_SESSION_SECRET=
# Used once by `npm run nx:seed-owner` to create the owner login.
OWNER_NAME=
OWNER_PHONE=
OWNER_PASSWORD=
